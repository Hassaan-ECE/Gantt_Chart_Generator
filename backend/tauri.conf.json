{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gantt Chart Creator",
  "version": "0.1.0",
  "identifier": "com.hassaan.ganttchartcreator",
  "build": {
    "beforeDevCommand": "bun run dev:frontend",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "bun run build:frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gantt Chart Creator",
        "width": 1050,
        "height": 650,
        "minWidth": 1050,
        "minHeight": 650,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
